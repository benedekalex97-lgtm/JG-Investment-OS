# JG Investment OS v0.6 - környezeti változók (SABLON; valós érték soha nem kerül verziókezelésbe)
# Részletek: docs/V0.6-PERSISTENCE.md

# Környezet-címke (kötelező): local | preview | production
JG_ENV=local

# Helyi fejlesztés: fájl alapú, valódi PostgreSQL (PGlite). Csak JG_ENV=local és Vercelen kívül engedett.
JG_PGLITE_DIR=.data/pg

# Előnézet / éles: külső PostgreSQL kapcsolati URL (ELŐNÉZET ÉS ÉLES KÜLÖN ADATBÁZIS!). Szerver-oldali titok.
# KÖTELEZŐ sslmode=require (vagy verify-full) nem helyi hoszthoz; a Neon direkt (nem pooler) hosztja ajánlott az első preview-hoz.
# DATABASE_URL=postgres://felhasznalo:jelszo@host:5432/adatbazis?sslmode=require
# TILOS: NEXT_PUBLIC_ előtagú DB/JG változó, JG_PGLITE_DIR Vercelen.

# Opcionális védelem: az éles adatbázis hosztneve(i); nem éles környezet ezekre nem csatlakozhat.
# JG_PRODUCTION_DB_HOSTS=db.pelda-eles.example

# Opcionális, csak JG_ENV=local mellett és DATABASE_URL használatakor: automatikus migráció
# JG_AUTO_MIGRATE=1


# Google sign-in (production always requires Google; password login is disabled).
# Enable for the protected integration environment too:
# JG_AUTH_MODE=google
# JG_APP_URL=https://crm.example.com
# GOOGLE_CLIENT_ID=<Google Cloud Web application OAuth client ID>
# GOOGLE_CLIENT_SECRET=<store directly in Vercel as Sensitive, never commit>
# Authorized redirect URI: https://crm.example.com/api/auth/google/callback
